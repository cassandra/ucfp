# UCFP environment configuration -- CLOUD (droplet) lane -- EXAMPLE
#
# Format: docker-compose env_file (KEY=value). No `export`, no shell quoting, no
# ${VAR} interpolation. This is the cloud counterpart to the repo-root
# local.env.example (the self-host lane). It documents the variables a droplet
# deployment sets. The live file is NOT generated by env-generate.py (which
# refuses production); maintain it by hand in .private/env/ and convert it to the
# compose format with deploy/droplet/docker-compose-env-convert.py (wired into the
# Makefile). See docs/dev/project/droplet-deployment.md.
#
# Every variable here is drawn from the one canonical env surface
# (ucfp.environment.server); this lane simply chooses cloud values: the MySQL
# backend, host redis, real authentication, and TLS host URLs.

# --- Core Django (required) ---
DJANGO_SETTINGS_MODULE=ucfp.settings.production
DJANGO_SERVER_PORT=8000
DJANGO_SECRET_KEY=<replace-with-50-char-random-string>

# --- Admin user (required) ---
DJANGO_SUPERUSER_EMAIL=admin@your-domain
DJANGO_SUPERUSER_PASSWORD=<replace-with-strong-password>

# --- Media path inside the container (required) ---
UCFP_MEDIA_PATH=/data/media

# --- Database: MySQL on the host (required for this lane) ---
# network_mode: host means the container reaches the host MySQL on 127.0.0.1.
# Setting these selects MySQL; do not also set UCFP_DB_PATH.
UCFP_DB_HOST=127.0.0.1
UCFP_DB_PORT=3306
UCFP_DB_NAME=ucfp_prod
UCFP_DB_USER=ucfp_prod_user
UCFP_DB_PASSWORD=<replace-with-db-password>

# --- Redis: host redis (required for this lane) ---
# The image is NOT running its bundled redis here; it connects to the droplet's
# native redis (installed by do-droplet-init.sh) on 127.0.0.1.
# UCFP_REDIS_DB_INDEX picks the logical DB index. On a droplet shared with another
# app, give each app its own index so their keyspaces stay isolated (a shared
# KEY_PREFIX cannot separate two apps built from the same image). Use the value
# assigned to ucfp in the droplet's index registry; 0 is fine on a dedicated host.
UCFP_BUNDLED_REDIS=false
UCFP_REDIS_HOST=127.0.0.1
UCFP_REDIS_PORT=6379
UCFP_REDIS_DB_INDEX=1

# --- Authentication (public instance: keep login ON) ---
# A publicly reachable deployment must require sign-in. Sign-in uses emailed
# one-time codes, so the email section below must be configured for login to work.
UCFP_SUPPRESS_AUTHENTICATION=false

# --- Public URL obfuscation (recommended on public deployments) ---
# Set to a UUID to hide /admin/ and /env/ behind an unguessable prefix.
UCFP_SECRET_URL_PREFIX_UUID=<replace-with-a-uuid>

# --- Data encryption (required; encrypts sensitive fields at rest) ---
UCFP_FIELD_ENCRYPTION_KEY=<replace-with-generated-fernet-key>

# --- Email / alerts (required on a public instance -- powers sign-in codes) ---
UCFP_EMAIL_SUBJECT_PREFIX=[UCFP]
UCFP_DEFAULT_FROM_EMAIL=noreply@your-domain
UCFP_SERVER_EMAIL=noreply@your-domain
UCFP_EMAIL_HOST=<smtp-host>
UCFP_EMAIL_PORT=587
UCFP_EMAIL_HOST_USER=<smtp-user>
UCFP_EMAIL_HOST_PASSWORD=<smtp-password>
UCFP_EMAIL_USE_TLS=true
UCFP_EMAIL_USE_SSL=false

# --- Network (required: the public host URL(s) served behind the TLS proxy) ---
# First entry becomes SITE_DOMAIN and is added to ALLOWED_HOSTS / CORS.
UCFP_EXTRA_HOST_URLS=https://your-domain
UCFP_EXTRA_CSP_URLS=
